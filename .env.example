# GitHub backend config — copy this file to .env.local and fill in real values.
# Get a fine-grained PAT at: https://github.com/settings/personal-access-tokens/new
# Scope it to ONLY the genai-platform repo, with permission: Contents = Read and Write.
VITE_GITHUB_TOKEN=your_fine_grained_pat_here
VITE_GITHUB_OWNER=sarbaniai
VITE_GITHUB_REPO=genai-platform
VITE_GITHUB_BRANCH=main
